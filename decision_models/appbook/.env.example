# The app reads this file, then the notebooks' ../.env. Keys stay on the server.
# Typical paths (gpt-4o-mini), MemoRizz embeddings, and OpenAI's Decisions API (gpt-6-luna).
OPENAI_API_KEY=
# TypeSafe's Jev.
TYPESAFE_API_KEY=
# Load d1-2B at start (about 7 GB) instead of on the first local decision.
DM_PRELOAD=0
# Delete a session's MemoRizz store and decision log on reset and on shutdown. Kept by default.
DM_CLEANUP=0
